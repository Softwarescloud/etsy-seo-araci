# Etsy uygulama kimlik bilgileri — https://www.etsy.com/developers/your-apps
#
# Etsy "x-api-key" başlığında İKİ değer ister: "keystring:shared_secret"
# İkisini tek satırda "a:b" biçiminde de yazabilirsin.
# Sadece keystring yetmez; Etsy "Shared secret is required" hatası döndürür.
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Kendi mağazanı bağlamak istersen (Mağaza Denetimi bölümü için gerekli)
# Mağaza adı, sondaki ".etsy.com" olmadan: orn. ETSY_SHOP_ID=magazaadi
ETSY_SHOP_ID=
# Etsy OAuth ile alınan kişisel erişim anahtarı (bazı endpoint'ler için gerekli)
ETSY_ACCESS_TOKEN=

# Sunucu
PORT=4310
HOST=127.0.0.1

# İstek hızı (Etsy saniyede 10 istek'e izin veriyor; güvenli kalmak için düşük tut)
REQUESTS_PER_SECOND=4

# Her arama başına kaç sayfa (48 ilan/sayfa) örnek alınsın
PAGES_PER_SEARCH=2

# "Rekabet" değeri için tek seferde en fazla kaç kelime doğrudan aransın
MAX_PROBE_CALLS=6

# Önbellek (dakika)
LISTING_CACHE_TTL_MINUTES=180
RESULT_COUNT_TTL_MINUTES=720

# --- Otomasyon ---
# Her gece otomatik mağaza denetimi + kelime tazelemesi
AUTOMATION_ENABLED=1
# Çalışma saati (0-23, sunucunun kendi saat dilimi)
AUTOMATION_HOUR=4
# Günde en fazla kaç kayıtlı kelimenin rekabeti tazelensin (Etsy kotası)
MAX_KEYWORD_REFRESH=15
