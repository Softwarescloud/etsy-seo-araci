# Etsy geliştirici API anahtarı — https://www.etsy.com/developers/apps
# Not: /listings/active (arama) endpoint'i için hesabın "Commercial / Production"
# erişimi açık olmalı. Anahtarsız "Private" uygulamalarda arama çağrıları 403 döner.
ETSY_API_KEY=

# Kendi mağazanı bağlamak istersen (Mağaza Denetimi bölümü için gerekli)
# Mağaza adı, sondaki ".etsy.com" olmadan: orn. ETSY_SHOP_ID=magazaadi
ETSY_SHOP_ID=
# Etsy OAuth ile alınan kişisel erişim anahtarı (bazı endpoint'ler için gerekli)
ETSY_ACCESS_TOKEN=

# Sunucu
PORT=4310
HOST=127.0.0.1

# İstek hızı (Etsy saniyede 10 istek'e izin veriyor; güvenli kalmak için düşük tut)
REQUESTS_PER_SECOND=4

# Her arama başına kaç sayfa (48 ilan/sayfa) örnek alınsın
PAGES_PER_SEARCH=2

# "Rekabet" değeri için tek seferde en fazla kaç kelime doğrudan aransın
MAX_PROBE_CALLS=6

# Önbellek (dakika)
LISTING_CACHE_TTL_MINUTES=180
RESULT_COUNT_TTL_MINUTES=720
